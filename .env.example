# Supabase（Project Settings > API）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Claude API（サーバー側のみで使用）
ANTHROPIC_API_KEY=

# Google Maps Platform
# サーバー用：Places API (New) と Routes API を有効化したキー（IP/無制限。ブラウザに出さない）
GOOGLE_MAPS_SERVER_KEY=
# ブラウザ用：Maps JavaScript API のみ。HTTPリファラー制限を付ける
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# 任意：Google Cloud Console で作成した Map ID（AdvancedMarker 用）
NEXT_PUBLIC_GOOGLE_MAP_ID=DEMO_MAP_ID

# 公開URL（シェアリンク・認証リダイレクトに使用）
NEXT_PUBLIC_SITE_URL=http://localhost:3000
